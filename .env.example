SECRET_KEY=change-me
SCAN_INTERVAL_SECONDS=300
# DATABASE_URL=sqlite:///food_deals.db

# Base URL of the deployed site, used to build unsubscribe links in emails.
# On Render/Railway, set this to your public https:// URL.
SITE_URL=http://127.0.0.1:5001

# Email notifications when a deal unlocks (via https://resend.com).
# Leave RESEND_API_KEY blank to disable notifications.
RESEND_API_KEY=
# NOTIFY_EMAIL_TO is optional now that /subscribe adds recipients via the
# site itself — it's still sent to every scan, in addition to subscribers.
NOTIFY_EMAIL_TO=you@example.com
# NOTIFY_EMAIL_FROM=FoodTracker <onboarding@resend.dev>
